inline ld triangleArea(ld a, ld b, ld c) {
  if (a < b) swap(a, b);
  if (a < c) swap(a, c);
  if (b < c) swap(b, c);
  // degenerate check
  if (a >= b + c) return 0.0L;
  // Kahan’s ¼·√((a+(b+c))·(c−(a−b))·(c+(a−b))·(a+(b−c))) formula:
  ld s1 = a + (b + c);
  ld s2 = c - (a - b);
  ld s3 = c + (a - b);
  ld s4 = a + (b - c);
  return 0.25L * sqrtl(s1 * s2 * s3 * s4);
}

inline ld triangleArea(ld x1, ld y1, ld x2, ld y2, ld x3, ld y3) {
  ld ux = x2 - x1;
  ld uy = y2 - y1;
  ld vx = x3 - x1;
  ld vy = y3 - y1;
  return fabsl(ux * vy - uy * vx) * 0.5L;
}
