ld solve(ld r1, ld r2, ld r3) {
  ld a = r2 + r3;
  ld b = r3 + r1;
  ld c = r1 + r2;

  ld s = (a + b + c) / 2.0;
  ld triangleArea = sqrtl(s * (s - a) * (s - b) * (s - c));
  
  ld A = acosl((b * b + c * c - a * a) / (2 * b * c));
  ld B = acosl((a * a + c * c - b * b) / (2 * a * c));
  ld C = acosl((a * a + b * b - c * c) / (2 * a * b));

  ld sectorArea = 0.5 * ((r1 * r1 * A) + (r2 * r2 * B) + (r3 * r3 * C));

  return triangleArea - sectorArea;
}
