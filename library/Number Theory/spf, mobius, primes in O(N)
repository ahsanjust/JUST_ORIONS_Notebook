// Linear Sieve: SPF, Euler Totient (phi), Mobius (mob), Number of Divisors (divisor), Prime Powers (cnt) in O(N)
const int N = 1e6 + 9;
int spf[N];      // Smallest prime factor
int phi[N];      // Euler's totient function
int mob[N];      // Möbius function
int divisor[N];  // Number of divisors d(n)
int cnt[N];      // Exponent of spf in n
vector<int> primes;

void linear_sieve() {
  phi[1] = mob[1] = divisor[1] = 1;
  for (int i = 2; i < N; i++) {
    if (!spf[i]) {
      spf[i] = i;
      primes.push_back(i);
      phi[i] = i - 1;
      mob[i] = -1;
      divisor[i] = 2;
      cnt[i] = 1;
    }
    for (int p : primes) {
      if (1LL * i * p >= N) break;
      spf[i * p] = p;
      if (i % p == 0) {
        phi[i * p] = phi[i] * p;
        mob[i * p] = 0;
        cnt[i * p] = cnt[i] + 1;
        divisor[i * p] = divisor[i] / (cnt[i] + 1) * (cnt[i * p] + 1);
        break;
      } else {
        phi[i * p] = phi[i] * (p - 1);
        mob[i * p] = -mob[i];
        cnt[i * p] = 1;
        divisor[i * p] = divisor[i] * 2;
      }
    }
  }
}
